# Copy to docker/.env and fill in the two secrets before `docker compose up`.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Required. Mixed into every stored auth hash. 16+ characters.
AUTH_PEPPER=

# Required. Encrypts BYOK provider keys at rest. Exactly 32 bytes, base64.
# If you lose this, stored provider keys cannot be recovered. Back it up.
ENCRYPTION_MASTER_KEY=

# Required. Password for the bundled Postgres.
POSTGRES_PASSWORD=
POSTGRES_USER=ahaai
POSTGRES_DB=ahaai

# Host port to publish. Defaults to 3001.
# AHAALI_PORT=3001

# Cross-origin clients. An exact origin is trusted for cookie auth; a wildcard
# like chrome-extension://* may read responses but must use a bearer token.
# CORS_ALLOWED_ORIGINS=chrome-extension://*

# Set to true once you serve the app over HTTPS.
# COOKIE_SECURE=true

# Set to 1 when a reverse proxy you control overwrites x-forwarded-for.
# TRUST_PROXY=1

# Optional. Enables shared rate limiting across replicas.
# REDIS_URL=redis://redis:6379
