# --- Core (required) ---
# Server-side pepper mixed into the stored auth hash. 16+ characters, 32 random
# bytes base64 is ideal.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_PEPPER=

# Encrypts BYOK provider API keys at rest. Exactly 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=

# --- Database ---
# Real Postgres connection string. Set this for production, or for development
# if you prefer a server over the embedded one.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ahaai
#
# Zero-setup embedded Postgres for local development. Used only when
# DATABASE_URL is not set and NODE_ENV is not production. Migrations are applied
# at startup, and data lives in ./.data/ahaai-dev. A production boot with this
# flag and no DATABASE_URL fails loudly instead of serving from a local file.
# AHAALI_ALLOW_EMBEDDED_DB=1

# --- Optional ---
# Redis for shared rate limiting + HIBP cache. Falls back to in-memory when unset.
# That fallback is per instance, so a multi-instance deployment needs this set
# or the effective login limit multiplies by the instance count.
REDIS_URL=

# Session lifetime in days (absolute, from sign in). Defaults to 30.
SESSION_TTL_DAYS=30

# Session cookie `Secure` flag. Defaults to on when NODE_ENV=production. Set
# this when the browser's scheme disagrees with the build: a production build
# on a plain-HTTP origin must set COOKIE_SECURE=false or the browser drops the
# cookie and sign in silently fails.
# COOKIE_SECURE=true

# Whether x-forwarded-for / x-real-ip may be believed. Defaults to trusting
# them, which is right behind a proxy or platform edge that overwrites them.
# Set to 0 when the app is reachable directly, so a caller cannot invent an IP
# to slip past the per-IP rate limits. Note that with 0 the app has no client
# address at all (the Fetch API exposes none), so all callers share a bucket.
# TRUST_PROXY=1

# User-Agent sent to HaveIBeenPwned (they require an identifiable UA).
HIBP_USER_AGENT=Ahaai-Password-Manager

# --- Optional env-based provider keys (used as BYOK fallback presets) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
