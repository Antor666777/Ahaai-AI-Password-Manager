# --- Required ---
# Server-side pepper mixed into the stored auth hash. 16+ characters; 32 random
# bytes as base64 is ideal.
# Changing this invalidates every existing login.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_PEPPER=

# Encrypts BYOK provider API keys at rest. Exactly 32 bytes, base64.
# Changing this makes stored provider keys permanently unreadable. There is no
# recovery for that, so back it up with your database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=

# --- Server ---
# Port the API listens on. Defaults to 3001.
# PORT=3001

# --- Database ---
# Real Postgres connection string. Required in production.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ahaai
#
# Zero-setup embedded Postgres for local development only, used when
# DATABASE_URL is absent. Data lives in ./data/ahaai-dev and migrations run at
# startup. A production boot with this flag and no DATABASE_URL fails loudly
# rather than serving from a local file.
# AHAALI_ALLOW_EMBEDDED_DB=1

# --- Sessions ---
# Session lifetime in days, absolute from sign in. Defaults to 30.
# SESSION_TTL_DAYS=30

# Session cookie `Secure` flag. Defaults to on when NODE_ENV=production. Set
# this when the browser's scheme disagrees with the build: a production build on
# a plain-HTTP origin must set COOKIE_SECURE=false, or the browser drops the
# cookie and sign in silently fails.
# COOKIE_SECURE=true

# Whether x-forwarded-for / x-real-ip may be believed. Defaults to trusting
# them, which is right behind a proxy or platform edge that overwrites them.
# Set to 0 when the API is reachable directly, so a caller cannot invent an IP
# to slip past the per-IP rate limits. Note that with 0 there is no client
# address at all (the Fetch API exposes none), so all callers share a bucket.
# TRUST_PROXY=0

# --- Cross-origin clients ---
# Comma-separated allowlist for the browser extension and any third-party
# frontend. An exact origin is also trusted for cookie auth; a wildcard such as
# `chrome-extension://*` may read responses but must use a bearer token.
# CORS_ALLOWED_ORIGINS=chrome-extension://*,https://app.example

# --- Serving the frontend ---
# Serve the exported SPA from this service, which keeps everything on one origin
# and makes the self-hosted bundle a single container.
# SERVE_STATIC=1

# Where the exported frontend lives. Defaults to ../web/out relative to the
# working directory.
# STATIC_ROOT=/app/web

# --- Optional ---
# Redis for shared rate limiting and HIBP caching. Falls back to in-memory when
# unset. That fallback is per instance, so a multi-instance deployment needs
# this set or the effective login limit multiplies by the instance count.
# REDIS_URL=redis://localhost:6379

# User-Agent sent to HaveIBeenPwned (they require an identifiable UA).
HIBP_USER_AGENT=Ahaai-Password-Manager

# --- Optional env-based provider keys (used as BYOK fallback presets) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Vercel AI Gateway, used for the decision-model search path (TypeSafe Jev).
# When set, cloud searches are answered by a typed decision model instead of a
# generative one: far faster, and it returns a probability per candidate rather
# than prose. Without it, search falls back to the ordinary language provider.
AI_GATEWAY_API_KEY=
