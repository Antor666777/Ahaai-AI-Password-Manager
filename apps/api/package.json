{
  "name": "@ahaai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist --external @electric-sql/pglite --external ioredis",
    "compile": "bun build src/bun.ts --compile --outfile dist/ahaai-server",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ahaai/core": "*",
    "@ahaai/db": "*",
    "@hono/node-server": "^1",
    "dotenv": "^17.4.2",
    "hono": "^4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
